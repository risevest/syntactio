{
  "name": "@risemaxi/syntactio",
  "version": "0.4.0",
  "description": "Linting and formatting config for Rise client apps. Supports ESLint, Oxlint, and Oxfmt.",
  "keywords": [
    "eslint",
    "eslintconfig",
    "expo",
    "oxfmt",
    "oxlint",
    "rise"
  ],
  "bugs": {
    "url": "https://github.com/risevest/syntactio/issues"
  },
  "author": {
    "name": "Risevest Developers",
    "url": "https://github.com/risevest/syntactio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/risevest/syntactio.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/eslint.cjs",
  "exports": {
    ".": {
      "types": "./dist/eslint.d.cts",
      "default": "./dist/eslint.cjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint/base.d.ts",
      "default": "./dist/oxlint/base.js"
    },
    "./oxlint/react": {
      "types": "./dist/oxlint/react.d.ts",
      "default": "./dist/oxlint/react.js"
    },
    "./oxlint/native": {
      "types": "./dist/oxlint/native.d.ts",
      "default": "./dist/oxlint/native.js"
    },
    "./oxlint/compiler": {
      "types": "./dist/oxlint/compiler.d.ts",
      "default": "./dist/oxlint/compiler.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./react-native-compat": {
      "types": "./dist/react-native-compat.d.ts",
      "default": "./dist/react-native-compat.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "npm run build"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "eslint": "^9.39.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "oxfmt": ">=0.59.0",
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=7.0.2003"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
